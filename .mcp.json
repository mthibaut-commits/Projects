{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated"
      ]
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?read_only=true"
    },
    "vercel": {
      "command": "node",
      "args": [
        ".mcp-servers/vercel/upstream/dist/index.js"
      ],
      "env": {
        "VERCEL_ACCESS_TOKEN": "${VERCEL_ACCESS_TOKEN:-}"
      }
    },
    "playwright": {
      "command": "node",
      "args": [
        ".mcp-servers/playwright/lanzar.mjs"
      ]
    },
    "graphify": {
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy[mcp]",
        "graphify-mcp",
        "graphify-out/graph.json"
      ]
    }
  }
}
