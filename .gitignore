# Salida generada por build_app.ps1 (regenerable; ~29 MB)
pipeline_comercial.html

# PNG de referencia de capturar_pantallas.mjs: se regeneran en cada corrida y no comprimen, asi que
# versionarlos hace crecer el repo unos 5 MB por vez. El HTML de al lado si va: es el entregable.
Capturas_UI/*.png

# PNG de referencia de capturar_variantes.mjs (mismo criterio que Capturas_UI)
Variantes_UI/*.png

# Configuracion PERSONAL del agente (la compartida, .claude/settings.json con los hooks, SI se versiona:
# un hook que no viaja con el repo es config personal, no una garantia)
.claude/settings.local.json

# El repo no tiene dependencias npm (node --test, sin librerias); si alguien instala algo local, no entra
node_modules/

# Worktrees: solo a pedido explicito del usuario (hook worktree_guard)
.worktrees/

# Snapshots que @playwright/mcp deja al navegar (regenerables, no son del proyecto)
.playwright-mcp/

# Grafo de graphify: 1,8 MB GENERADOS por `graphify extract` (regla núcleo 10: se regenera, no se versiona)
graphify-out/
